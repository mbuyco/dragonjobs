# Frontend (Vite) — no environment variables are currently required.
# The app calls `/api/*` relative URLs; `vite.config.ts` proxies them to
# http://localhost:3001 in development.
#
# Vite only exposes variables prefixed with VITE_ to client code
# (via import.meta.env). Add them here when needed, e.g.:
# VITE_API_BASE_URL=
