# SQLite connection (file: relative paths resolve from backend/)
DATABASE_URL=file:./data/dragonjobs.db

# HTTP API listen port (npm run serve)
PORT=3001

# Comma-separated search terms for ingest adapters
INGEST_KEYWORDS=developer,software engineer,devops,software,programmer,software architect

# Max Kalibrr search result pages to fetch (50 jobs per page)
KALIBRR_MAX_PAGES=5

# Remotive API category slug
REMOTIVE_CATEGORY=software-dev

# Hard-delete jobs whose synced_at is older than this many hours (each ingest run)
JOB_TTL_HOURS=2160

# Skip new inserts whose source postedAt is older than this many hours (90 days).
INGEST_LOOKBACK_HOURS=2160
